  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly --declaration --noEmit false --outDir dist",
