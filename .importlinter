[importlinter]
root_packages =
    skeleton
    providers
    debt-collector
    medium
include_external_packages = True

[importlinter:contract:no-sibling-projects]
name = skeleton must not import medium or debt_collector
type = forbidden
source_modules =
    skeleton
forbidden_modules =
    medium
    debt_collector
allow_indirect_imports = True

[importlinter:contract:layers]
name = subsystem layering (verify is lowest, api is top)
type = layers
layers =
    skeleton.api
    skeleton.personas
    skeleton.mcp
    skeleton.signals
    skeleton.ingest
    skeleton.verify

[importlinter:contract:no-model-sdks]
name = no model or cloud SDK imports
type = forbidden
source_modules =
    skeleton
forbidden_modules =
    anthropic
    openai
    boto3
    google
allow_indirect_imports = True

[importlinter:contract:no-providers]
name = skeleton must not import providers
type = forbidden
source_modules =
    skeleton
forbidden_modules =
    providers
allow_indirect_imports = True
[importlinter:contract:collector-no-medium]
name = debt-collector must not import medium
type = forbidden
source_modules =
    debt-collector
forbidden_modules =
    medium
[importlinter:contract:collector-no-model-sdks]
name = debt-collector must not import a model SDK
type = forbidden
source_modules =
    debt-collector
forbidden_modules =
    anthropic
    openai
    boto3
    google
allow_indirect_imports = True
[importlinter:contract:collector-public-surface]
name = debt-collector uses only the skeleton public surface
type = forbidden
source_modules =
    debt-collector
forbidden_modules =
    skeleton.verify.citation
    skeleton.verify.claim
    skeleton.verify.parse
    skeleton.verify.textnorm
    skeleton.verify.flow
    skeleton.verify.codes
    skeleton.personas.generator
    skeleton.personas.prompt
    skeleton.personas.grounding
    skeleton.mcp.router
    skeleton.mcp.tools
    skeleton.signals.store
    skeleton.ingest
    skeleton.api.retention
allow_indirect_imports = True
